{
  "name": "krautkompass",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "php -S 127.0.0.1:8095 -t api/public api/dev-router.php",
    "build": "tsc -b && node scripts/clean-public.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
