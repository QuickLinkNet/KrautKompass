# KrautKompass – Server-Konfiguration
# Kopieren nach api/.env (wird nicht eingecheckt und nie vom Deploy hochgeladen).
# Auf dem Server liegt sie unter /html/apps/krautkompass/.env und wird per FTP gepflegt.

# Öffentliche Adresse ohne Slash am Ende (für Links in Mails)
APP_URL=https://krautkompass.red-it.org
APP_DEBUG=false

# Erster Admin: wird beim ersten Aufruf angelegt, solange es noch keinen gibt.
# Danach ist er ohne Wirkung – das Passwort bitte nach dem ersten Login hier löschen
# (die E-Mail stehen lassen, sonst wäre die Einrichtung im Browser wieder offen).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Carsten
INSTANCE_NAME=Kraut Kurier

# Passwort-Reset per Mail: none (aus) | mail (PHP mail())
MAIL_TRANSPORT=none
MAIL_FROM=

# Optional: Rechtstexte, werden unter dem Login verlinkt (nur https)
IMPRINT_URL=
PRIVACY_URL=
