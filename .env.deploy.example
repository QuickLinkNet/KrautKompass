# Kopieren nach ".env.deploy" (wird nicht versioniert).
# Gleicher Webspace wie die anderen red-it-Apps (Alfahosting).

FTP_HOST=web17.alfahosting-server.de
FTP_USER=web1738
FTP_PASSWORD=
FTP_PORT=21

# true = verschlüsselt (Standard). Nur true darf die .env hochladen; false nur im Notfall für Code-Updates.
FTP_SECURE=true

# Achtung Alfahosting: FTP-Wurzel liegt über dem Docroot, deshalb /html/... – das Skript
# arbeitet ausschließlich in einem Ordner, der auf /krautkompass endet.
REMOTE_BASE_DIR=/html/apps/krautkompass

# Für diese Adresse wird gebaut (auch Unterordner, z. B. https://www.red-it.org/apps/krautkompass)
PUBLIC_APP_URL=https://krautkompass.red-it.org
